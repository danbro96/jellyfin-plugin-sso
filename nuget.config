<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!--
      TODO(jf12-stable): remove this source (and the credentials below) once 12.0.0 is on nuget.org.
      Jellyfin 12.0.0 is still pre-release: its packages are published to the Jellyfin
      GitHub Packages feed, not nuget.org.
    -->
    <add key="jellyfin-unstable" value="https://nuget.pkg.github.com/jellyfin/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
      <!--
        Jellyfin.MediaEncoding.Keyframes and Jellyfin.Database.Implementations are transitive
        dependencies of the 12.0.0 Controller but are NOT published to the Jellyfin GitHub
        Packages feed (only 7 Jellyfin.* packages are). They live on nuget.org (10.11.x line).
        These more-specific patterns route them here; the csproj pins explicit available
        versions to override the unpublished nightly builds.
      -->
      <package pattern="Jellyfin.MediaEncoding.*" />
      <package pattern="Jellyfin.Database.*" />
    </packageSource>
    <packageSource key="jellyfin-unstable">
      <package pattern="Jellyfin.*" />
    </packageSource>
  </packageSourceMapping>
  <packageSourceCredentials>
    <!--
      Credentials are read from environment variables, so nothing secret is committed.
      Local dev: set GITHUB_ACTOR (your GitHub username) and GITHUB_TOKEN (a PAT with
      `read:packages`). CI: GitHub Actions provides both automatically.
    -->
    <jellyfin-unstable>
      <add key="Username" value="%GITHUB_ACTOR%" />
      <add key="ClearTextPassword" value="%GITHUB_TOKEN%" />
    </jellyfin-unstable>
  </packageSourceCredentials>
</configuration>
